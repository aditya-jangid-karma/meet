{
  "access-restriction": {
    "PreToolUse": [
      {
        "matcher": "view_file|replace_file_content|write_to_file|list_dir|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/restrict_access.py"
          }
        ]
      }
    ]
  }
}
